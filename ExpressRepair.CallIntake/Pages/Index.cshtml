@page
@{
    ViewData["Title"] = "Call leads";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Call leads — Express Repair</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="page-header">
        <div>
            <h1>Call leads</h1>
            <p class="subtitle">Voicemails arriving by webhook, transcribed and structured automatically.</p>
        </div>
        <div class="status-line">
            <span id="liveDot" class="dot"></span>
            <span id="liveText">connecting…</span>
        </div>
    </header>

    <section class="panel">
        <h2>Simulate an incoming call</h2>
        <p class="hint">
            Each button posts a provider-shaped payload to the real webhook
            (<code>POST /api/calls/recording</code>). The row appears as
            <strong>Processing</strong> and updates on its own.
        </p>
        <div class="button-row">
            <button class="btn" data-sample="1">1 — Samsung fridge, urgent</button>
            <button class="btn" data-sample="2">2 — Whirlpool washer, no rush</button>
            <button class="btn" data-sample="3">3 — Oven, brand unknown</button>
            <button class="btn btn-warn" data-sample="4">4 — Unintelligible (fails)</button>
        </div>
        <p id="simulateResult" class="result" role="status"></p>
    </section>

    <section class="panel">
        <table id="leadsTable">
            <thead>
                <tr>
                    <th>Phone</th>
                    <th>Customer name</th>
                    <th>Appliance</th>
                    <th>Brand</th>
                    <th>Problem</th>
                    <th>Urgency</th>
                    <th>Status</th>
                    <th>Received at</th>
                </tr>
            </thead>
            <tbody id="leadsBody">
                <tr><td colspan="8" class="empty">Loading…</td></tr>
            </tbody>
        </table>
    </section>

    <script src="~/js/app.js"></script>
</body>
</html>
